# Copy this file to .env.local and fill in your values.
# In production these are set as Vercel environment variables.

# ── Supabase ────────────────────────────────────────────────────────────────
# Settings → API in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ─────────────────────────────────────────────────────────────────────
# Your deployed URL. Used to build QuickBooks redirects and share links.
NEXT_PUBLIC_SITE_URL=https://bone-one.vercel.app
# Any long random string. Cron routes reject requests without it.
CRON_SECRET=change-me-to-something-long-and-random

# ── Web push ────────────────────────────────────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dispatch@example.com

# ── QuickBooks Online ───────────────────────────────────────────────────────
# From your app at developer.intuit.com. The redirect URI must match exactly.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://bone-one.vercel.app/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=production

# ── Document scanning (Fleet) ───────────────────────────────────────────────
# Reads registrations, fuel receipts and shop bills off a photo and fills the
# form. From console.anthropic.com → API keys. Without it the Scan buttons
# say scanning is off; everything else works.
ANTHROPIC_API_KEY=

# ── Invoice email ───────────────────────────────────────────────────────────
# "Send Invoice" emails the customer through Resend (resend.com). The From
# address must be on a domain verified there. Without these two the invoice
# is still created and filed under Invoices; it just isn't emailed.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=Bone Trucking <billing@your-domain.com>
